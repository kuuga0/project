  <!-- FOOTRIX direct cell layer: generated from the canonical 154-point layout.
       Each fixed child link is an independent visual-only marker.
       radius=0.003401643 m, thickness=0.004000 m, layout=footrix_layout.json.
       The original left/right ankle-pitch foot collision meshes remain the
       complete foot-ground contact surface underneath this overlay by design;
       contact impulses are projected to these markers by the recorder. Replace only the
       coordinates in this block when the calibrated installation layout is
       available. -->
  <link name="left_footrix_cell_000">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
