+        for _ in range(100):
+            interface.emit([contact_header(1)], [contact]); buffer.pop([0])
+        self.assertEqual(len(buffer._packets), 0)
+        interface.emit([contact_header(0)], [contact])
+        self.assertEqual(len(buffer._packets[(0, "left")]), 1)
+        buffer.close(); buffer.close()
