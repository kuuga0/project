+    def test_marker_links_collapse_without_merging_actuated_joints(self):
+        source = LAB_DIR / "h2_plus_lab/assets/h2_plus.py"
+        tree = ast.parse(source.read_text())
+        asset = next(node.value for node in tree.body if isinstance(node, ast.Assign)
+            and any(isinstance(target, ast.Name) and target.id == "H2_PLUS_CFG" for target in node.targets))
+        spawn = next(keyword.value for keyword in asset.keywords if keyword.arg == "spawn")
+        merge = ast.literal_eval(next(keyword.value for keyword in spawn.keywords if keyword.arg == "merge_fixed_joints"))
+        urdf = LAB_DIR.parent / "robot_asset/h2_plus/H2_Plus_with_footrix_no_dex_hands.urdf"
+        robot = ET.parse(urdf).getroot()
+        links = {link.get("name"): link for link in robot.findall("link")}
+        fixed_parents = {
+            joint.find("child").get("link"): joint.find("parent").get("link")
+            for joint in robot.findall("joint") if joint.get("type") == "fixed"
+        } if merge else {}
+
+        def body(name):
+            while name in fixed_parents:
+                name = fixed_parents[name]
+            return name
+
+        active = [joint for joint in robot.findall("joint") if joint.get("type") == "revolute"]
+        self.assertEqual(len({body(name) for name in links}), 32)
+        self.assertEqual(len(active), 31)
+        for joint in active:
+            self.assertNotEqual(body(joint.find("parent").get("link")), body(joint.find("child").get("link")))
+        markers = [name for name in links if "_footrix_cell_" in name]
+        self.assertEqual(len(markers), 308)
+        for name in markers:
+            self.assertEqual(body(name), f"{name.split('_')[0]}_ankle_pitch_link")
+            self.assertIsNone(links[name].find("collision"))
+            self.assertIsNotNone(links[name].find("visual"))
+        for side in ("left", "right"):
